[Desktop Entry]
# Linux 桌面入口（freedesktop .desktop 规范）。
# 随 tar.gz 一并分发；制作 AppImage 时也会被打进 AppDir。
Type=Application
Version=1.0
Name=AIGCPannel
GenericName=Model Downloader
Comment=Download ComfyUI models from Civitai / HuggingFace into the right folders
# Exec 仅写二进制名：要求 comfy-downloader 在 PATH 中，或 AppImage 运行时自动注入。
Exec=comfy-downloader
# 图标在程序运行时程序化生成，仓库无图标文件；此处给出约定名，
# 桌面环境找不到对应图标时会回退为通用图标，不影响启动。
Icon=comfy-downloader
Terminal=false
Categories=Graphics;Utility;
Keywords=ComfyUI;Stable Diffusion;Civitai;HuggingFace;model;download;
