# ==============================================================================
# AI 短剧一条龙工作台后端 — 环境变量示例（2026-08 激进清理后架构）
# 全部使用 IPv4；复制为 .env 后按需修改。未列出的字段见 app/config.py 默认值。
#
# 当前真实架构：
#   LLM/VLM  : spark02  192.168.71.84:8000  (qwen3.6-uncensored, OpenAI 兼容)
#   图像     : SDXL 经 ComfyUI-LB  192.168.71.127:8188 (3 后端: gpu0/pc01/pc02)
#   视频主   : MiniMax H3 独立 ComfyUI 实例  192.168.71.127:8195
#   LTX-2.5  : workstation GPU0 专用 ComfyUI 实例 192.168.71.127:8198
#   TTS      : IndexTTS-2  192.168.71.127:9200
#   ASR      : AI-Omni (faster-whisper large-v3)  192.168.71.127:9210
# 已下线（2026-08，代码已移除）：xDiT :8288 / LatentSync :8289 / video-enhance :8290
#   / DeepFilterNet :8301 / HunyuanImage :8600 / FLUX+PuLID :8601 / LTX-2B pc01:8700
# ==============================================================================

# === 主 LLM / 视觉质检统一入口（spark02:8000, qwen3.6-uncensored FP8）===
# 字段名沿用 exo_* 仅为兼容旧代码；实际指向 spark02，非 EXO 集群
EXO_BASE_URL=http://192.168.71.84:8000/v1
EXO_API_KEY=not-needed
EXO_MODEL_GLM52=qwen3.6-uncensored
EXO_MODEL_KIMI=qwen3.6-uncensored

# 视觉质检模型（VLM，实测支持 image_url 输入；与主 LLM 同入口）
VISUAL_MODEL_URL=http://192.168.71.84:8000/v1
VISUAL_MODEL_NAME=qwen3.6-uncensored

# --- M16.2/M18.2/M18.3 质检与锚定开关 ---
# 分镜拼贴检测：关键帧生成后 VLM 校验出场角色外貌一致性，失真自动重试
STORYBOARD_APPEARANCE_CHECK=true
# 三视图 VLM 质检：角色卡入库前拦截废品视图，不合格换 seed 重生成（fail-open）
CHARACTER_VIEW_QC_ENABLED=true
CHARACTER_VIEW_QC_MAX_RETRIES=2
# 分镜关键帧定妆照 IPAdapter 锚定（参考图上传异常自动回退原工作流）
STORYBOARD_KEYFRAME_ANCHOR_ENABLED=true
STORYBOARD_KEYFRAME_ANCHOR_WEIGHT=0.6
IPADAPTER_SDXL_MODEL_NAME=ip-adapter_sdxl_vit-h.safetensors
IPADAPTER_CLIP_VISION_NAME=CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors
# LB 后端直连清单（逗号分隔）：定妆照同名复制到每个后端，避免跨后端 LoadImage 400
COMFYUI_LB_BACKEND_URLS=

# --- M18.4 H3 画风漂移治理（约束 + 检测 + 纠偏）---
H3_STYLE_ANCHOR_ENABLED=true
H3_STYLE_QC_ENABLED=true
H3_STYLE_QC_MAX_RETRIES=1

# === ComfyUI 集群（LB 统一入口 8188；禁止直连单卡后端 8189/8193）===
COMFYUI_IMAGE_HQ=http://192.168.71.127:8188
COMFYUI_IMAGE_FAST=http://192.168.71.127:8188
COMFYUI_VIDEO_A=http://192.168.71.127:8188
COMFYUI_VIDEO_B=http://192.168.71.127:8188
# 视频生成并发度上限（与在线视频 worker 数对齐）
VIDEO_MAX_CONCURRENCY=2

# === 图像生成：SDXL 为唯一在线后端（经 ComfyUI-LB）===
# checkpoint 由 style_anchor 按写实性自动选择（majicMIX / animagineXL40）
IMAGE_BACKEND=sdxl

# === 视频生成主后端：'h3'（MiniMax H3 33B 音视频联合）/ 'comfyui'（回退 Wan 2.2）===
VIDEO_BACKEND=h3

# --- MiniMax H3（workstation 独立 ComfyUI 实例 :8195，GPU0 UNet + GPU2 CLIP/VAE）---
H3_COMFYUI_URL=http://192.168.71.127:8195
H3_UNET_NAME=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_CLIP_NAME=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_VIDEO_VAE_NAME=minimax_h3_video_vae_fp16.safetensors
H3_AUDIO_VAE_NAME=minimax_h3_audio_vae_fp32.safetensors
H3_WIDTH=768
H3_HEIGHT=1344
H3_STEPS=20
H3_SAMPLER=res_multistep
H3_SCHEDULER=simple
H3_RESULT_TIMEOUT=1800.0

# --- H3 Turbo LoRA（可选加速，默认关闭；20 步 → 4-8 步）---
H3_TURBO_ENABLED=false
H3_TURBO_LORA_NAME=minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors
H3_TURBO_STEPS=6
H3_TURBO_STRENGTH=1.0
H3_TURBO_LOW_VRAM=false

# --- H3 ref2va 参考图生成（跨分镜角色一致性）---
H3_REF_UNET_NAME=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_REF_IMAGE_SIZE=match
H3_REF_MAX_IMAGES=9
H3_REF_MAX_VIDEOS=3
H3_REF_MAX_AUDIOS=3

# --- H3 多镜叙事联合生成（同集相邻场景合并一次推理再切分）---
H3_MULTISHOT_ENABLED=true
H3_MULTISHOT_MAX_SCENES=3
H3_MULTISHOT_MAX_SECONDS=14.0

# --- M17 H3 全模态能力（原生 CUT 语法 / 音频方向 / 末帧链式锚定）---
H3_NATIVE_CUT_PROMPT_ENABLED=true
H3_AUDIO_DIRECTION_ENABLED=true
H3_LAST_FRAME_CHAIN_ENABLED=true

# --- H3 原生音轨混音（环境音垫底于人声之下）---
H3_NATIVE_AUDIO_ENABLED=true
H3_AMBIENCE_GAIN=0.25
H3_DYNAMIC_GAIN_ENABLED=true
H3_AMBIENCE_GAIN_DENSE=0.15
H3_AMBIENCE_GAIN_SPARSE=0.40

# --- M20 长视频分块续写（PoC，默认关闭）---
LONG_VIDEO_ENABLED=false
LONG_VIDEO_MAX_CHUNKS=4
LONG_VIDEO_CHUNK_SECONDS=5
LONG_VIDEO_FRAME_PREFIX=longvideo_chain

# === LTX-2.5 视频（workstation GPU0 专用 ComfyUI 实例 :8198，音画同出）===
# 与 H3 路由分工：空镜/动作/长场景/快速分镜预览走 LTX-2.5
LTX_ENABLED=true
LTX_COMFYUI_URL=http://192.168.71.127:8198
LTX_RESULT_TIMEOUT=600.0

# === TTS 配音：'indextts'（ToIV 共用）/ 'cosyvoice' / 'edge'（回退）===
TTS_BACKEND=indextts
# IndexTTS-2（workstation:9200，真实契约 POST /tts multipart 返回 WAV）
INDEXTTS_ENDPOINT=http://192.168.71.127:9200
INDEXTTS_MODEL=IndexTTS-2
INDEXTTS_TIMEOUT=60.0
# 备选 CosyVoice 2-0.5B（待部署到独立端口）
COSYVOICE_ENDPOINT=http://192.168.71.127:9201/v1
COSYVOICE_MODEL=CosyVoice2-0.5B
COSYVOICE_TIMEOUT=60.0
# faster-whisper 回退模型
WHISPER_MODEL=tiny

# === ASR 字幕：'ai_omni'（默认）/ 'firered' / 'whisper'（回退）===
ASR_BACKEND=ai_omni
# AI-Omni ASR（faster-whisper large-v3，workstation GPU2，OpenAI 兼容端点）
AI_OMNI_ASR_ENDPOINT=http://192.168.71.127:9210
AI_OMNI_ASR_TIMEOUT=180.0
# FireRedASR（回退，当前未部署）
FIRERED_ASR_ENDPOINT=http://192.168.71.127:8300/v1
FIRERED_ASR_MODEL=FireRedTeam/FireRedASR-AED-L
FIRERED_ASR_TIMEOUT=120.0

# === 内置 RAG 提示词优化 ===
RAG_OPTIMIZE_ENABLED=true
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=5

# === 模型下载器配置共享（crate/OS 配置目录仍为 comfy-downloader）===
DOWNLOADER_CONFIG_PATH=config.json
# models.json：下载器已下载清单。不设则用 OS 配置目录 comfy-downloader/models.json
# macOS: ~/Library/Application Support/comfy-downloader/models.json
# Linux: ~/.config/comfy-downloader/models.json
# Windows: %APPDATA%/comfy-downloader/models.json
# DOWNLOADER_MODELS_JSON=

# === 后端服务 ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8100
CORS_ORIGINS=http://localhost:3501,http://localhost:8085,http://localhost:5173
