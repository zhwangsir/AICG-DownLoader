# === LLM 推理服务（spark01 vLLM, qwen3.6-35b-a3b-awq）===
# spark01 IPv6: 240e:b8f:1d22:e700:3a8b:56c1:3275:4437
EXO_BASE_URL=http://[240e:b8f:1d22:e700:3a8b:56c1:3275:4437]:8000/v1
EXO_API_KEY=not-needed
EXO_MODEL_GLM52=qwen3.6-35b-a3b-awq
EXO_MODEL_KIMI=kimi-k2-instruct

# === 视觉质检模型（workstation GPU0+1, Qwen3-VL-72B BF16 TP）===
# workstation IPv6: 240e:b8f:1d22:e700:57fc:3cf9:d856:e46c
VISUAL_MODEL_URL=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8200/v1
VISUAL_MODEL_NAME=Qwen/Qwen3-VL-72B-Instruct

# === ComfyUI 集群（workstation 4×RTX PRO 6000, 统一 LB 入口 8188）===
# AGENTS.md 硬规则: 禁止直连单卡端口 8189-8192
COMFYUI_IMAGE_HQ=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8188
COMFYUI_IMAGE_FAST=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8188
COMFYUI_VIDEO_A=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8188
COMFYUI_VIDEO_B=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8188

# === P4.1 视频生成升级：xDiT + HunyuanVideo 1.5 多卡并行 ===
# xDiT 独立推理引擎（workstation, 4 卡并行 HunyuanVideo 1.5 8.3B）
XDIT_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8288
# 视频后端：'xdit' (默认, HunyuanVideo 1.5) / 'comfyui' (回退 Wan 2.2)
VIDEO_BACKEND=xdit
XDIT_MODEL=hunyuanvideo-1.5
XDIT_NUM_FRAMES=97
XDIT_RESOLUTION=720p
XDIT_CFG_PARALLEL=2
XDIT_ULYSSES_DEGREE=2
XDIT_PIPEFUSION_PARALLEL=1
XDIT_STEPS=20
XDIT_CFG=6.0
XDIT_SEED=0
XDIT_REQUEST_TIMEOUT=600.0
XDIT_POLL_INTERVAL=3.0

# === P4.2 ASR/TTS 升级：FireRedASR + CosyVoice 2 + IndexTTS-2 ===
# ASR 后端：'firered' (默认, FireRedASR-AED-L 1.1B, CER <1%) / 'whisper' (回退)
ASR_BACKEND=firered
FIRERED_ASR_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8300/v1
FIRERED_ASR_MODEL=FireRedTeam/FireRedASR-AED-L
FIRERED_ASR_TIMEOUT=120.0
WHISPER_MODEL=tiny

# TTS 后端：'cosyvoice' (默认, zero-shot 克隆) / 'indextts' (情感解耦) / 'edge' (回退)
TTS_BACKEND=cosyvoice
COSYVOICE_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8400/v1
COSYVOICE_MODEL=CosyVoice2-0.5B
COSYVOICE_TIMEOUT=60.0
INDEXTTS_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8500/v1
INDEXTTS_MODEL=IndexTTS-2
INDEXTTS_TIMEOUT=60.0

# === P4.3 图像生成升级：HunyuanImage 2.1 + FLUX+PuLID + LTX-Video 预览 ===
# 图像后端：'hunyuanimage' (默认, 17B FP8 原生 2K 中文 prompt) / 'flux_pulid' (角色 ID 一致性) / 'sdxl' (回退)
IMAGE_BACKEND=hunyuanimage
HUNYUANIMAGE_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8600/v1
HUNYUANIMAGE_MODEL=HunyuanImage-2.1
HUNYUANIMAGE_TIMEOUT=180.0
HUNYUANIMAGE_DEFAULT_RESOLUTION=1024x1024
HUNYUANIMAGE_DEFAULT_NUM_IMAGES=1
FLUX_PULID_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8601/v1
FLUX_PULID_MODEL=flux.1-dev-pulid
FLUX_PULID_TIMEOUT=180.0
FLUX_PULID_DEFAULT_RESOLUTION=1024x1024

# LTX-Video 分镜预览（pc01, 8GB 显存, 5s 预览视频约 20s 生成）
LTX_VIDEO_ENABLED=false
LTX_VIDEO_ENDPOINT=http://[240e:b8f:1d22:e700:ed1c:6c64:7c1e:8e2a]:8700/v1
LTX_VIDEO_MODEL=ltx-video-2b
LTX_VIDEO_TIMEOUT=60.0
LTX_VIDEO_DEFAULT_NUM_FRAMES=65
LTX_VIDEO_DEFAULT_RESOLUTION=512x320

# === P4.4 唇形同步 + 后处理：LatentSync 1.6 + RealBasicVSR + RIFE + ProPainter + DeepFilterNet3 + Mac FFmpeg ===
# 唇形同步（默认关闭，失败时降级返回原视频）
LIP_SYNC_ENABLED=false
LATENTSYNC_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8289/v1
LATENTSYNC_MODEL=LatentSync-1.6
LATENTSYNC_TIMEOUT=300.0
LATENTSYNC_RESOLUTION=512
LATENTSYNC_SEED=0

# 后处理总开关（默认关闭，单步开关在下方独立控制）
POSTPROCESS_ENABLED=false
# 后处理统一入口（workstation, ComfyUI 包装的 RealBasicVSR/RIFE/ProPainter）
POSTPROCESS_ENDPOINT=http://[240e:b8f:1d22:e700:57fc:3cf9:d856:e46c]:8290/v1

# 步骤 1: 超分 RealBasicVSR x4 (1080p→4K)
POSTPROCESS_SUPER_RESOLUTION_ENABLED=true
REALBASICVSR_MODEL=RealBasicVSR-x4
REALBASICVSR_SCALE=4
REALBASICVSR_TIMEOUT=600.0

# 步骤 2: 插帧 RIFE (24fps→60fps)
POSTPROCESS_FRAME_INTERPOLATION_ENABLED=true
RIFE_MODEL=rife-v4
RIFE_TARGET_FPS=60
RIFE_TIMEOUT=300.0

# 步骤 3: 视频修复 ProPainter (去水印/去穿帮, 默认关闭)
POSTPROCESS_INPAINTING_ENABLED=false
PROPAINTER_MODEL=ProPainter
PROPAINTER_TIMEOUT=600.0

# 步骤 4: 音频降噪 DeepFilterNet3 (Mac 集群, Rust 原生 CPU 实时)
POSTPROCESS_AUDIO_DENOISE_ENABLED=true
DEEPFILTERNET_ENDPOINT=http://[240e:b8f:1d22:e700:1092:6aff:fe7a:4d20]:8301/v1
DEEPFILTERNET_MODEL=deepfilternet3
DEEPFILTERNET_TIMEOUT=60.0

# 步骤 5: 最终编码 Mac FFmpeg VideoToolbox H.265 (4K)
POSTPROCESS_FINAL_ENCODE_ENABLED=true
POSTPROCESS_FINAL_CODEC=hevc_videotoolbox
POSTPROCESS_FINAL_CRF=20
POSTPROCESS_FINAL_PRESET=medium
POSTPROCESS_FINAL_RESOLUTION=3840x2160

# === AICG-DownLoader 配置共享（相对于项目根目录）===
DOWNLOADER_CONFIG_PATH=config.json

# === 后端服务 ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8100
CORS_ORIGINS=http://localhost:8085,http://localhost:5173,http://localhost:1420
